# هات القيم دول من Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# اختياري — لو عايزة زرار "ربط مع Google Calendar" في صفحة المخطط يشتغل
# لو سايباه فاضي، الزرار ببساطة مش هيظهر والباقي كله بيفضل شغال عادي
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# مفتاح Finnhub لأسعار الـ Trading Desk (سيرفر-سايد بس، مش هيظهر في المتصفح أبدًا)
# سجّلي مجانًا على https://finnhub.io/register وحطي المفتاح هنا محليًا،
# وكمان في إعدادات الـ hosting (Vercel وغيره) تحت Environment Variables.
FINNHUB_API_KEY=

# مفتاح Google Gemini لـ "Ahmed's AI" (سيرفر-سايد بس برضه)
# سجّلي مجانًا على https://aistudio.google.com/apikey
GEMINI_API_KEY=
